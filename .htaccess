# Plugin directory only: maps /local/page/<slug> → index.php?menuname=<slug> (mod_rewrite + AllowOverride required).
# Characters match PARAM_ALPHANUMEXT (includes .). Optional trailing slash on the slug path is accepted.
# Root-level /about-us URLs are not handled here; add vhost rules under the Moodle docroot (see README.md).
# If Moodle is in a subdirectory, you may need e.g. RewriteBase /moodle/local/page/ (match your URL path).
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass through real files/directories inside this folder.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^([a-zA-Z0-9._-]+)/?$ index.php?menuname=$1 [QSA,L]
</IfModule>
